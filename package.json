{
  "name": "saju-flow-consultation",
  "version": "0.1.2",
  "private": true,
  "description": "Offline Windows consultation app reconstructed from the approved Excel first worksheet.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/run-electron.cjs dist-electron/main.cjs\"",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:artifacts": "python scripts/validate_artifacts.py",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "capture:ui": "node scripts/run-electron.cjs scripts/capture-ui.cjs",
    "dist": "npm run test && npm run build && electron-builder --win nsis",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/song-myung": "^5.3.1",
    "echarts": "^6.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "kr.co.consultation.sajuflow",
    "productName": "인생 흐름 주기",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "SajuFlow-${version}-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
